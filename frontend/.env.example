# Frontend env. Copy to frontend/.env — Next loads this directory on its own.
# The backend has its own file at backend/.env; nothing there reaches Next.

# ---- Required. No fallback by design: a missing value must fail loudly, ----
# ---- not silently resolve to a same-origin path that 404s in production. ----
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Do NOT set NODE_ENV here. Next forces it per command and ignores this file:
#   next dev            -> development
#   next build / start  -> production
#
# Do NOT set PORT here either. Next reads PORT from the shell, not from .env.
# `npm run dev` pins 3002 via the -p flag; for `next start` use PORT=3002 npm start.
