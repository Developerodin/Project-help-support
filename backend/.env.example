# Backend env. Copy to backend/.env — loaded by src/platform/loadEnv.js.
# The frontend has its own file at frontend/.env; nothing here reaches Next.

# ---- Required: the backend refuses to start without these ----
MONGODB_URL=mongodb://localhost:27017/pms
JWT_SECRET=generate-a-real-32-plus-character-secret-here
FRONTEND_BASE_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3002

# ---- Optional: safe defaults shown ----
NODE_ENV=development
PORT=4000
# COOKIE_DOMAIN=
# Refresh token cookie (httpOnly, path=/v1/auth). Default embed mode: SameSite=None + Secure.
# REFRESH_COOKIE_SAMESITE=none
# REFRESH_COOKIE_SECURE=true   # required when SameSite=none; default true in production and embed mode
# COOKIE_DOMAIN=.theodin.ai   # only if sharing cookies across subdomains
#
# ---- Non-embed deployments (top-level login only): override to SameSite=Strict ----
# REFRESH_COOKIE_SAMESITE=strict
# REFRESH_COOKIE_SECURE=   # default: true in production, false in development when SameSite=strict
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# ---- Neutral/default branding (used when no active company assignment) ----
# Optional absolute URLs surfaced on auth session payloads as effectiveBranding.logoUrl/faviconUrl.
# NEUTRAL_BRAND_LOGO_URL=https://cdn.example.com/prowplus/logo.png
# NEUTRAL_BRAND_FAVICON_URL=https://cdn.example.com/prowplus/favicon.ico
#
# Optional filesystem path to inline email logo image. Absolute path or relative to repo root.
# EMAIL_BRAND_MARK_PATH=shared/email/assets/prowplus-icon.png

# ---- Capability group: storage. All four, or none. Absent disables attachments. ----
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
# AWS_S3_BUCKET_NAME=   # optional alias for S3_BUCKET (matches uat.dharwin.backend/.env)

# ---- Capability group: email. All five, or none. Absent disables email. ----
# SMTP transport for invite mail and ticket notification emails (nodemailer).
# Mirror Dharwin names for easy copy from uat.dharwin.backend/.env:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USERNAME=your-mailbox@company.com
# SMTP_PASSWORD=your-app-password-or-secret
# EMAIL_FROM="Help & Support <your-mailbox@company.com>"
#
# Port 587 uses STARTTLS (secure=false). Port 465 uses implicit TLS (secure=true).
# Optional: set SMTP_TLS_REJECT_UNAUTHORIZED=false only for dev/self-signed certs.
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ---- Capability group: seed. Required on FIRST boot only. ----
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
